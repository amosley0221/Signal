<?xml version="1.0" encoding="utf-8"?>
<!-- The Signal Agent on the PC speaks plain HTTP on the home network / tailnet, and Sonos speakers only speak HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
